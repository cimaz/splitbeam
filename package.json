{
  "name": "splitbeam",
  "productName": "SplitBeam",
  "version": "0.2.0",
  "description": "A dual pane file browser",
  "main": "src/main.js",
  "homepage": "https://github.com/cimaz/splitbeam",
  "repository": {
    "type": "git",
    "url": "https://github.com/cimaz/splitbeam.git"
  },
  "author": {
    "name": "SplitBeam Developers",
    "email": "bochtis.d@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "preversion": "node scripts/changelog.js check",
    "version": "node scripts/changelog.js release && git add CHANGELOG.md"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.cimaz.splitbeam",
    "productName": "SplitBeam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "build/icon.png",
      "category": "System;FileTools;FileManager",
      "synopsis": "Dual pane file browser",
      "description": "A keyboard-friendly dual pane file browser with favorites and folder sync.",
      "executableName": "splitbeam",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "SplitBeam",
        "GenericName": "File Manager",
        "Keywords": "files;file manager;dual pane;commander;sync;",
        "StartupWMClass": "SplitBeam"
      }
    },
    "deb": {
      "packageName": "splitbeam",
      "priority": "optional",
      "fpm": [
        "--category",
        "utils"
      ]
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  }
}
